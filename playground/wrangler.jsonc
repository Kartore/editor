{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "kartore-playground",
	"compatibility_date": "2026-07-05",
	"compatibility_flags": ["nodejs_als"],
	"main": "./worker.ts",
	"assets": {
		// /api/* だけ worker、それ以外は静的ファイル。ファイルが無ければ worker が受け、
		// ページには index.html (SPA)、消えたアセット (/assets/…) には 404 を返す (createCloudflareHandler)
		"binding": "ASSETS",
		"not_found_handling": "none",
		"run_worker_first": ["/api/*"]
	}
}
