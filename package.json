{
	"name": "@kartore/editor",
	"version": "0.4.0",
	"type": "module",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Kartore/editor.git"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"dist",
		"README.md"
	],
	"imports": {
		"#src": "./src",
		"#src/*": "./src/*"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts"
		},
		"./types": {
			"types": "./src/types.ts"
		},
		"./storage": {
			"types": "./src/storage.ts",
			"default": "./src/storage.ts"
		},
		"./paths": {
			"types": "./src/paths.ts",
			"default": "./src/paths.ts"
		},
		"./export": {
			"types": "./src/export.ts",
			"default": "./src/export.ts"
		},
		"./server": {
			"types": "./src/server/index.ts",
			"default": "./src/server/index.ts"
		},
		"./server/cloudflare": {
			"types": "./src/server/cloudflare.ts",
			"default": "./src/server/cloudflare.ts"
		},
		"./server/node": {
			"types": "./src/server/node.ts",
			"default": "./src/server/node.ts"
		},
		"./server/kv": {
			"types": "./src/server/kv.ts",
			"default": "./src/server/kv.ts"
		},
		"./theme.css": "./src/theme.css",
		"./vite": {
			"types": "./dist/vite.d.ts",
			"import": "./dist/vite.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "pnpm --filter playground dev",
		"build": "tsdown",
		"build:playground": "pnpm --filter playground build",
		"test": "vitest run",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"prepare": "pnpm build"
	},
	"peerDependencies": {
		"@tanstack/svelte-query": "^6.0.0",
		"bits-ui": "^2.0.0",
		"maplibre-gl": "^6.0.0",
		"phosphor-svelte": "^3.0.0",
		"svelte": "^5.57.0",
		"tailwindcss": "^4.0.0",
		"vite": "^8.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tanstack/svelte-query": "^6.1.48",
		"@types/node": "^26.4.0",
		"bits-ui": "^2.19.0",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"fake-indexeddb": "^6.2.8",
		"globals": "^17.11.0",
		"maplibre-gl": "^6.19.0",
		"phosphor-svelte": "^3.1.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tsdown": "^0.23.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.0",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/language": "^6.12.4",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.9",
		"@internationalized/number": "^3.6.7",
		"@kartore/glyphore": "^0.2.0",
		"@kartore/spritore": "^0.4.0",
		"@maplibre/maplibre-gl-style-spec": "^26.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"clsx": "^2.1.1",
		"fflate": "^0.8.3",
		"srvx": "1.0.6",
		"tailwind-merge": "^3.6.0"
	},
	"packageManager": "pnpm@12.1.0",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.5.0",
			"onFail": "download"
		}
	}
}
